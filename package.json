{
  "name": "s3-client",
  "version": "0.1.0",
  "description": "A Finder-style desktop browser for S3-compatible storage.",
  "main": "./out/main/index.js",
  "author": "S3 Client contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider vitest run",
    "test:e2e": "cross-env NODE_OPTIONS=--openssl-legacy-provider playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@smithy/node-http-handler": "^4.14.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/s3rver": "^3.7.4",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "s3rver": "^3.7.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
